# Credenciales de Upslat
UPSLAT_USERNAME=tu-email@example.com
UPSLAT_PASSWORD=tu-password

# Lista de atletas: ';' separa filas, ',' separa columnas (nombre,género M/F)
ATHLETES=Atleta Uno,M;Atleta Dos,F;Atleta Tres,M

# Lista de eventos: ';' separa filas, ',' separa columnas (nombre,género M/F/X)
# M = solo hombres, F = solo mujeres, X = ambos (por defecto)
EVENTS=100 metros,X;100 metros vallas,F;110 metros vallas,M

# Configuración de entorno
NODE_ENV=production
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Puerto del servidor web
WEB_PORT=3000
